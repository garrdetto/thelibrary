# ======================= Axiom Bot (.env) =======================
# Copy to .env and fill in. Never commit .env.

# --- Web API / admin tab -------------------------------------------------
# Long random password: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_PASSWORD=
# Origins allowed to call the API from a browser ("*" only for local testing)
# ALLOWED_ORIGINS=https://your-site.example,https://www.your-site.example
ALLOWED_ORIGINS=*
WS_HEARTBEAT_SECONDS=15

# --- Solana RPC (use a paid RPC such as Helius, QuickNode or Triton) ------
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Defaults to RPC_URL with https:// turned into wss://
# RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
COMMITMENT=confirmed

# --- Wallet (a dedicated hot wallet with only what the bot may spend) -----
# Base58 secret key (Phantom: Settings > Manage accounts > Show private key)
# or a JSON byte array. Or point KEYPAIR_PATH at a solana-keygen JSON file.
PRIVATE_KEY=
# KEYPAIR_PATH=/opt/axiom-bot/keypair.json
# For dry runs without a key, the wallet address alone shows the balance:
# WALLET_PUBLIC_KEY=

# --- Jupiter (free key at https://portal.jup.ag) --------------------------
JUPITER_API_KEY=
JUPITER_API_URL=https://api.jup.ag/swap/v1
PRIORITY_LEVEL=veryHigh
# Cap on the priority fee per trade, in lamports (1,000,000 = 0.001 SOL)
PRIORITY_FEE_MAX_LAMPORTS=1000000

# --- Risk limits (the UI can never go past these) -------------------------
MAX_BUY_AMOUNT_SOL=0.1
MAX_TRADES_PER_RUN=5
MIN_SOL_RESERVE=0.02
MAX_PRICE_IMPACT_PCT=25
MAX_SIGNAL_AGE_S=20
# Skip pump.fun curve variants (1 = skip, recommended: most unsellable coins in testing were variants)
SKIP_CURVE_VARIANTS=1

# --- Tuning (defaults are fine) -------------------------------------------
# QUOTE_RETRIES=4
# QUOTE_RETRY_DELAY_S=0.6
# CONFIRM_TIMEOUT_S=45
# EXECUTOR_CONCURRENCY=2
# LISTENER_CONCURRENCY=8
