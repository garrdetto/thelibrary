# --- Axiom Bot web API (add these to your bot's .env / .env.example) ---

# Password for the control panel, the admin "Axiom Bot" tab and every control endpoint.
# Use a long random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_PASSWORD=

# Comma-separated origins allowed to call the API from a browser.
# "*" is only for local testing. Production example:
# ALLOWED_ORIGINS=https://thelibrary.example,https://www.thelibrary.example
ALLOWED_ORIGINS=*

# Hard cap the web UI can never exceed (also read from config.py if set there).
MAX_BUY_AMOUNT_SOL=1.0

# Seconds between WebSocket heartbeat pings.
WS_HEARTBEAT_SECONDS=15

# Used for the wallet balance shown in the status bar if rpc_client.py has no get_wallet_info().
# (Any of these names also work from config.py.)
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=...
# WALLET_PUBLIC_KEY=
