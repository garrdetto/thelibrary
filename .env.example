# Axiom Radar tracker worker (scripts/axiom-tracker). Copy to .env and fill in. Never commit .env.
# Helius API key for runner-wallet tracking (https://dashboard.helius.dev). Leave empty to disable wallet tracking.
HELIUS_API_KEY=
# Optional Solana RPC endpoint. Defaults to Helius mainnet RPC using HELIUS_API_KEY.
SOLANA_RPC_URL=
# Shared secret for pushing updates to the site (same value as the Worker secret AXIOM_RADAR_TOKEN). At least 24 characters.
AXIOM_RADAR_TOKEN=
# Site that receives the updates.
AXIOM_SITE_ORIGIN=https://thelibrary.garrdetto.workers.dev

# Optional overrides
# Launch filter (defaults shown): 5m volume USD, 5m trades, liquidity USD, minimum buy share, coins tracked
# AXIOM_MIN_VOLUME_5M=3000
# AXIOM_MIN_TXNS_5M=40
# AXIOM_MIN_LIQUIDITY=3000
# AXIOM_MIN_BUY_RATIO=0.4
# AXIOM_MAX_CANDIDATES=30
# AXIOM_DB_PATH=data/axiom-tracker.db
# AXIOM_SESSION_DIR=axiom-session
# AXIOM_PAGES=6
# Where viewer counts come from: browser (automated Chromium), extension (the Axiom Radar Bridge extension in your own Chrome) or off.
# AXIOM_COLLECTOR=browser
# AXIOM_EXTENSION_PORT=8791
# AXIOM_HEADLESS=1
# Browser for login and collection: bundled (Playwright Chromium), chrome or msedge. Unset tries them in that order.
# AXIOM_BROWSER_CHANNEL=chrome
# AXIOM_DEBUG=0
# AXIOM_DEBUG_WS=0
