{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thelibrary",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thelibrary-db",
      "database_id": "75857474-7ee7-4e9b-a37a-0b60265d4291",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "FILES", "id": "dd2a555458e249009207869d12fc90e9" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MAPLE_WORLD", "class_name": "MapleStreetWorld" },
      { "name": "FOX_LAKE_WORLD", "class_name": "FoxLakeWorld" },
      { "name": "ANGLER_LAKE", "class_name": "AnglerLake" },
      { "name": "BUSHLEAGUE_MATCH", "class_name": "BushLeagueMatch" },
      { "name": "HOOD_LOT", "class_name": "HoodLot" },
      { "name": "DARTS_ROOM", "class_name": "DartsRoom" }
    ]
  },
  "migrations": [
    { "tag": "maplestreet-v1", "new_sqlite_classes": ["MapleStreetWorld"] },
    { "tag": "angler-lake-v1", "new_sqlite_classes": ["AnglerLake"] },
    { "tag": "bushleague-match-v1", "new_sqlite_classes": ["BushLeagueMatch"] },
    { "tag": "hood-lot-v1", "new_sqlite_classes": ["HoodLot"] },
    { "tag": "darts-room-v1", "new_sqlite_classes": ["DartsRoom"] },
    { "tag": "foxlake-world-v1", "new_sqlite_classes": ["FoxLakeWorld"] }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "thelibrary-db-preview",
        "database_id": "4241efe7-4e96-4f92-bc81-9575dab5cede",
        "migrations_dir": "migrations"
      }
    ],
    "kv_namespaces": [
      { "binding": "FILES", "id": "bbc64a1366344259811bbdb9b3cb3c2a" }
    ]
  }
}
