{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": ["Edit", "Write", "Bash(git *)", "Bash(gh *)", "Bash(pnpm *)", "Bash(npm *)", "Bash(npx *)", "Bash(node *)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
