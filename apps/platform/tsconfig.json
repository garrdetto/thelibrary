{
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "build/**/*.ts",
    "vite.config.ts",
    "../../packages/shared/src/**/*.ts",
    "../../packages/shared/src/**/*.tsx",
    "../../modules/*/src/**/*.ts",
    "../../modules/*/src/**/*.tsx"
  ],
  "exclude": ["../../node_modules", "../../modules/maple-street"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../../packages/shared/src/*"],
      "@modules/*": ["../../modules/*"]
    }
  }
}
