# Workers static assets honour this file. Hashed build output never changes at a URL, so it caches for a year;
# models, module files and images keep their paths across releases, so they revalidate daily and serve stale meanwhile.
/modules/chunks/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/models/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/modules/maplestreet/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/modules/sprites/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/modules/shorttrack-car.bin
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
