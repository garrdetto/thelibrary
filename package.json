{
  "name": "verse-and-vision",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "assets": "node scripts/assets.mjs",
    "assets:check": "node scripts/assets.mjs --check",
    "assets:report": "node scripts/assets.mjs --report",
    "build": "vite build",
    "test": "tsc -p tsconfig.engine.json && node --test server/park/park.test.mjs && node scripts/maplestreet-tests.mjs && node scripts/fairway-tests.mjs && node scripts/demoderby-tests.mjs",
    "gate": "node scripts/module-gate.mjs",
    "engine:smoke": "node scripts/engine-smoke.mjs",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@dimforge/rapier3d-compat": "0.14.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@google/genai": "^2.28.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/vite": "4.2.2",
    "@tanstack/devtools-vite": "0.5.5",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.41",
    "@vitejs/plugin-react": "5.2.0",
    "cannon-es": "0.20.0",
    "colyseus.js": "0.15.28",
    "esbuild": "0.28.2",
    "lucide-react": "0.576.0",
    "matter-js": "^0.20.0",
    "meshoptimizer": "1.1.1",
    "peerjs": "1.5.4",
    "postprocessing": "6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.34.5",
    "socket.io-client": "^4.8.4",
    "streamdown": "2.5.0",
    "tailwindcss": "4.2.2",
    "three": "0.186.1",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "6.1.1",
    "wrangler": "latest",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.186.0",
    "playwright": "1.63.0",
    "rimraf": "6.1.3",
    "typescript": "5.9.3"
  }
}
