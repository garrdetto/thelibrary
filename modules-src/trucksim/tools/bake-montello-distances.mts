/**
 * Bakes the road distance between every pair of Montello work zones into `shared/montello/MontelloDistances.ts`, so the Worker
 * prices Montello jobs from a table instead of building the road graph on every cold start. Run after the Montello roads or
 * sites change (after `bake-montello-roads.mts`): `node node_modules/tsx/dist/cli.mjs modules-src/trucksim/tools/bake-montello-distances.mts`.
 * `tests/montello.test.ts` fails while the table is stale.
 */
import { writeFileSync } from 'node:fs'
import { MONTELLO_SITES, montelloRoute } from '../shared/montello/MontelloWorld'

const zones = MONTELLO_SITES.flatMap((site) => site.zones)
const rows: number[][] = zones.map((from) => zones.map((to) => (from === to ? 0 : Math.round(montelloRoute(from.x, from.z, to.x, to.z).length))))
writeFileSync('modules-src/trucksim/shared/montello/MontelloDistances.ts', `/**
 * Generated by \`modules-src/trucksim/tools/bake-montello-distances.mts\`: road metres between every pair of Montello work zones
 * (row = from, column = to, in \`MONTELLO_DISTANCE_ZONES\` order). Do not edit.
 */
export const MONTELLO_DISTANCE_ZONES: readonly string[] = ${JSON.stringify(zones.map((z) => z.id))}

export const MONTELLO_DISTANCES: readonly (readonly number[])[] = [
${rows.map((row) => `  [${row.join(',')}]`).join(',\n')},
]
`)
console.log(`baked ${zones.length} zones, ${zones.length * zones.length} distances`)
