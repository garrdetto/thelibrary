/**
 * Bakes Montello's drivable roads and road bridges (highways, county roads, streets and minor roads: road kinds 0–3 in Tello's map) into
 * `shared/montello/MontelloRoads.ts` for Truck Simulator's GPS routes and job distances, in Life Sim's right-handed town frame
 * (x east, z = −map z). Each road is simplified to within `TOLERANCE` metres and rounded to 10 cm. Run with
 * `node node_modules/tsx/dist/cli.mjs modules-src/trucksim/tools/bake-montello-roads.mts` after the Montello map changes.
 */
import { readFileSync, writeFileSync } from 'node:fs'

interface RoadData { k: number; w: number; n: string; p: number[] }

const TOLERANCE = 2
const doc = JSON.parse(readFileSync('public/modules/tello/montello.json', 'utf8')) as { roads: RoadData[]; bridges: RoadData[] }

function simplify(points: [number, number][], tolerance: number): [number, number][] {
  if (points.length < 3) return points
  const keep = new Uint8Array(points.length)
  keep[0] = keep[points.length - 1] = 1
  const stack: [number, number][] = [[0, points.length - 1]]
  while (stack.length) {
    const [a, b] = stack.pop() as [number, number]
    const [ax, az] = points[a]
    const [bx, bz] = points[b]
    const dx = bx - ax, dz = bz - az
    const len = Math.hypot(dx, dz) || 1
    let far = -1, worst = 0
    for (let i = a + 1; i < b; i++) {
      const d = Math.abs((points[i][0] - ax) * dz - (points[i][1] - az) * dx) / len
      if (d > worst) { worst = d; far = i }
    }
    if (far >= 0 && worst > tolerance) {
      keep[far] = 1
      stack.push([a, far], [far, b])
    }
  }
  return points.filter((_p, i) => keep[i])
}

const round = (v: number) => Math.round(v * 10) / 10
const roads = [...doc.roads, ...doc.bridges].filter((r) => r.k <= 3).map((r) => {
  const points: [number, number][] = []
  for (let k = 0; k + 1 < r.p.length; k += 2) points.push([round(r.p[k]), round(-r.p[k + 1])])
  return { k: r.k, w: Math.round(r.w * 10) / 10, points: simplify(points, TOLERANCE) }
})
const flat = roads.map((r) => `[${r.k},${r.w},${r.points.flat().join(',')}]`)
const total = roads.reduce((s, r) => s + r.points.length, 0)
writeFileSync('modules-src/trucksim/shared/montello/MontelloRoads.ts', `/**
 * Generated by \`modules-src/trucksim/tools/bake-montello-roads.mts\` from Tello's Montello map: ${roads.length} roads, ${total} points.
 * Each entry is [road kind (0 highway, 1 county road, 2 street, 3 minor road), width, x0, z0, x1, z1, …] in Life Sim's town frame. Do not edit.
 */
export const MONTELLO_ROAD_DATA: readonly (readonly number[])[] = [
${flat.join(',\n')},
]
`)
console.log(`baked ${roads.length} roads, ${total} points`)
