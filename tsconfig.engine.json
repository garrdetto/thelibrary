{
  "include": [
    "engine/**/*.ts",
    "modules-src/_template/**/*.ts",
    "modules-src/fairway/**/*.ts",
    "modules-src/demoderby/**/*.ts",
    "modules-src/angler/**/*.ts",
    "modules-src/foxplains2/**/*.ts",
    "modules-src/county/**/*.ts",
    "modules-src/bushleague/**/*.ts",
    "modules-src/shorttrack/next/**/*.ts"
  ],
  "exclude": [
    "modules-src/fairway/tests/**",
    "modules-src/demoderby/tests/**",
    "modules-src/angler/tests/**",
    "modules-src/county/tests/**",
    "modules-src/bushleague/tests/**"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true
  }
}
